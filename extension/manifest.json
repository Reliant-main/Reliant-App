{
  "manifest_version": 3,
  "name": "Reliant Page Reader",
  "version": "0.5.0",
  "description": "Reads sales off your Whatnot, TikTok and eBay live pages and sends them to the Reliant Ticket System. The Reliant Tickets sidebar shows the show's sales, buyer history and payments.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.whatnot.com/*",
    "https://*.tiktok.com/*",
    "https://*.ebay.com/*",
    "https://vmpysxfmfyvwheqbuicj.supabase.co/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reliant Page Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.whatnot.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.whatnot.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "readers.js",
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.ebay.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.ebay.com/*"
      ],
      "js": [
        "readers.js",
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://reliant-main.github.io/Reliant-App/*"
      ],
      "js": [
        "announce.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
